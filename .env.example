# ---------------------------------------------------------------------------
# AI VIRTUAL OUTFIT STUDIO — configuration
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# These variables are read by the BACKEND ONLY and never reach the browser.
# ---------------------------------------------------------------------------

# --- HUGGING FACE (Inference Providers) ------------------------------------
# Token from https://huggingface.co/settings/tokens
# Needs the "Make calls to Inference Providers" permission.
HF_TOKEN=

# Pin one model. Leave empty to use the built-in ladder, which prefers models
# that can actually use your uploaded references:
#
#   USES YOUR PHOTOS (image-to-image)      cost      identity preserved
#     Qwen/Qwen-Image-Edit-2509            paid      yes  (takes 3 references)
#     black-forest-labs/FLUX.1-Kontext-dev paid      yes  (takes 1 reference)
#
#   IGNORES YOUR PHOTOS (text-to-image)    cost      identity preserved
#     black-forest-labs/FLUX.1-schnell     free-ish  NO — invents a face
#     black-forest-labs/FLUX.1-dev         paid      NO — invents a face
#
# HF_MODEL=Qwen/Qwen-Image-Edit-2509

# Text-to-image models cannot see the uploaded person, so they produce a
# stranger wearing a generic gown. They are disabled unless you opt in.
# When one is used the API response carries `identityPreserved: false` and the
# result page tells the user the face is not theirs.
HF_ALLOW_TEXT_TO_IMAGE=0

# --- GOOGLE GEMINI (alternative primary provider) --------------------------
# Free tier available from Google AI Studio: https://aistudio.google.com/apikey
# This is the only value you need to set to enable real generation.
GEMINI_API_KEY=

# Image model. Default is Nano Banana 2.
#   gemini-3.1-flash-image       Nano Banana 2        (default)
#   gemini-3-pro-image           Nano Banana Pro
#   gemini-2.5-flash-image       Nano Banana
#   gemini-3.1-flash-lite-image  Nano Banana 2 Lite
# If the configured model is unavailable to your key, the adapter automatically
# walks down this list rather than failing.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Output size requested from Gemini: 1K | 2K | 4K
GEMINI_IMAGE_SIZE=2K

# --- PROVIDER SELECTION ----------------------------------------------------
# The provider tried first.  gemini | fal | replicate | fashn | openai | demo
AI_PROVIDER=hf

# Ordered fallback chain. If the first provider fails — API error, timeout,
# quota, unavailable model, network fault, unusable response — the next one is
# tried automatically and the user sees no error. Leave empty to use
# AI_PROVIDER first followed by every other provider that has a key.
# AI_PROVIDER_CHAIN=hf,gemini

# --- OPTIONAL FALLBACK PROVIDERS -------------------------------------------
# Each is used only if its key is present.
FAL_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
FASHN_API_KEY=

# Replicate models name their reference-image array differently.
# AI_INPUT_IMAGES_KEY=image_input

# --- GENERATION ------------------------------------------------------------
# Output ratio hint: 3:4 | 2:3 | 1:1 | 4:5
AI_ASPECT_RATIO=3:4

# Per-provider generation budget in ms. Exceeding it moves to the next provider.
# Keep under the platform's function limit (Vercel Hobby caps at 60s).
AI_TIMEOUT_MS=55000

# --- SERVER ----------------------------------------------------------------
PORT=3000

# Print the internal generation prompt to the server console.
# Development only — the internal prompt is not meant to be shared.
DEBUG_PROMPT=0

# Point the Gemini adapter at a different base URL (proxy, mock, Vertex-style
# gateway). Defaults to the official endpoint.
# GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- LOGGING ---------------------------------------------------------------
# Verbose provider logs are ON unless NODE_ENV=production. Force them with:
# DEBUG=1
