# ---------------------------------------------------------------------------
# AI VIRTUAL OUTFIT STUDIO — configuration
# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
# These variables are read by the BACKEND ONLY and are never sent to the browser.
# ---------------------------------------------------------------------------

# Which generation provider to use.
# Supported: demo | gemini | fal | replicate | fashn | openai
# Leave empty (or set to `demo`) to run the full UX without any API key.
AI_PROVIDER=demo

# The API key / token for the selected provider.
# NEVER commit this value. NEVER expose it to frontend JavaScript.
AI_API_KEY=

# Optional: override the default model used by the selected provider.
#   gemini    -> gemini-2.5-flash-image
#   fal       -> fal-ai/nano-banana/edit
#   replicate -> google/nano-banana
#   fashn     -> tryon-v1.6
#   openai    -> gpt-image-1
AI_MODEL=

# Optional: name of the array field that carries the reference images for the
# selected Replicate model (schemas differ from one model to another).
# Default: image_input
AI_INPUT_IMAGES_KEY=

# Optional: aspect ratio hint forwarded to providers that support it.
# Examples: 3:4 | 2:3 | 1:1 | 4:5
AI_ASPECT_RATIO=3:4

# Optional: how long (ms) the backend waits for a generation before giving up.
AI_TIMEOUT_MS=240000

# HTTP port for the application server.
PORT=3000

# Set to 1 to print the internal generation prompt to the server console.
# Never enable this in production: the internal prompt is not meant to be shared.
DEBUG_PROMPT=0
